# ==============================================================================
# AWS Documentation RAG & Agent Assistant - Environment Configuration Template
# Copy this file to `.env` and fill in the values for local development.
# ==============================================================================

# 1. AWS Configuration (Used for Bedrock calls locally)
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your_aws_access_key_id
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key
# Optional (Use if using temporary/session-based IAM credentials):
# AWS_SESSION_TOKEN=your_aws_session_token

# 2. Database Connection String
# For local postgres docker containers:
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/aws_docs

# For AWS hosted RDS (constructed dynamically by App Runner via Terraform outputs/secrets):
# DATABASE_URL=postgresql://<db_username>:<db_password>@<db_host>:<db_port>/<db_name>

# 3. Amazon Bedrock Model Identifiers
BEDROCK_EMBED_MODEL_ID=amazon.titan-embed-text-v2:0
BEDROCK_CLASSIFY_MODEL_ID=anthropic.claude-3-haiku-20240307-v1:0
BEDROCK_GENERATE_MODEL_ID=anthropic.claude-3-5-sonnet-20240620-v1:0

# 4. Third-Party Search Providers
# Get a key from https://tavily.com for search engine fallbacks:
TAVILY_API_KEY=your_tavily_api_key
